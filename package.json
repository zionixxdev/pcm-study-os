{
  "name": "pcm-study-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PCM Study OS - personal academic management system for CBSE Class 11 PCM students",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:pages": "BASE_PATH=/${GH_REPO:-pcm-study-os}/ npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "dexie": "4.0.8",
    "dexie-react-hooks": "1.1.7",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.8.2",
    "katex": "0.16.11",
    "lucide-react": "0.441.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/jspdf": "1.3.3",
    "@types/katex": "0.16.7",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.4.0",
    "@typescript-eslint/parser": "8.4.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.11",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.0",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vite": "5.4.8",
    "vitest": "2.0.5"
  }
}
