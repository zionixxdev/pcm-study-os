# Copy to .env.local for local development. Never commit real values.
# Supabase project URL (Settings -> API)
VITE_SUPABASE_URL=
# Supabase anon / publishable key (safe for the browser; RLS protects data)
VITE_SUPABASE_ANON_KEY=
# Optional: sub-path deployment (e.g. /pcm-study-os/ for GitHub Pages)
BASE_PATH=/
